{
  "name": "bahasajourney-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "BahasaJourney Android Capacitor application",
  "scripts": {
    "sync:web": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});fs.copyFileSync('../index.html','www/index.html')\"",
    "android:init": "npm run sync:web && npx cap add android",
    "android:sync": "npm run sync:web && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.0",
    "@capacitor/android": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0"
  }
}
